# Copy to .env and fill in. .env is gitignored; never commit it.

# Nebius Token Factory key for the Nemotron models (the attendant, disputes, the price check)
NEBIUS_API_KEY=

# Telegram alerts (SPOTTER_ALERTS=telegram): the bot's token; the chat id is found and saved on first use.
# Texts to the bot from that chat are read too: a driver's message becomes a dispute, "/price" runs a price check.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The camera (or a video file). The password stays here, off the command line; it is never printed.
SPOTTER_SOURCE=rtsp://user:password@192.168.1.50:554/stream1
# Watch zone x0,y0,x1,y1 as fractions of the frame; python -m spotter.calibrate proposes one
SPOTTER_ZONE=0.35,0.27,0.69,0.69
SPOTTER_PROCESS_FPS=5
SPOTTER_MIN_DET_CONF=0.5
SPOTTER_ARRIVE_READS=5
SPOTTER_ARRIVE_WINDOW_S=3
# Seconds a plate must go unread (watched time) before the car counts as gone: 30 for the live camera
SPOTTER_LEAVE_AFTER_S=30

# Alerts: console (prints) or telegram. Start with console; set telegram once the bot's token is filled in above.
SPOTTER_ALERTS=console
# The signal light: console (prints) or kasa. Start with console; set kasa once the bulb is on the network
# and SPOTTER_LIGHT_HOST holds the host that scripts/light_test.py finds.
SPOTTER_LIGHT=console
SPOTTER_LIGHT_HOST=
SPOTTER_LIGHT_BRIGHTNESS=100
# Only if the bulb asks for the Kasa account
KASA_USERNAME=
KASA_PASSWORD=

# Money and timers
SPOTTER_MIN_CHARGE_CENTS=100
SPOTTER_ENDING_SOON_S=600
SPOTTER_OVERSTAY_GRACE_S=300
SPOTTER_OVERSTAY_FEE_CENTS=500

# Disputes: the owner's goodwill rule for waiving a disputed overstay fee (on/off, and how close to
# the fee's start the car's last read must be, in minutes)
SPOTTER_WAIVE_FEES=off
SPOTTER_WAIVE_WITHIN_MIN=10

# The second pair of eyes (Cosmos Reason on a Nebius endpoint): off, cosmos, or script:<file> for tests.
# scripts/cosmos_up.py writes COSMOS_URL and COSMOS_TOKEN here; scripts/cosmos_down.py deletes the endpoint.
SPOTTER_SCENE=off
SPOTTER_SPOT_DESCRIPTION=the paved driveway in the foreground, between the house on the left and the fence on the right
SPOTTER_SCENE_CHECK_AFTER_S=8
SPOTTER_SCENE_RELOOK_EVERY_S=15
SPOTTER_SCENE_IDLE_EVERY_S=15
SPOTTER_SCENE_UNREADABLE_AFTER_S=20
SPOTTER_SCENE_TIMEOUT_S=15
COSMOS_URL=
COSMOS_TOKEN=
# The Hugging Face token that can read nvidia/Cosmos-Reason2-8B; scripts/cosmos_up.py needs it to create the endpoint
HF_TOKEN=

# Tonight's price: the owner's three hourly prices in dollars, the lot's area and radius for the event
# search (the area is never printed), the Tavily key, the model that decides, and an optional daily
# check time (local HH:MM)
SPOTTER_RATE_BASE=5.00
SPOTTER_RATE_BUSY=8.00
SPOTTER_RATE_PEAK=12.00
SPOTTER_LOT_AREA=
SPOTTER_EVENT_RADIUS_MILES=5
# Venues inside the radius that code searches first, one search each for today's date (at most four),
# before the judge's own three searches; the names are placeholders, the real ones go in .env
SPOTTER_NEARBY_VENUES=Big Stadium, Old Arena, The Music Hall
TAVILY_API_KEY=
SPOTTER_PRICE_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
SPOTTER_PRICE_CHECK_AT=

# The owner's page (python -m spotter.run --dashboard, or SPOTTER_DASHBOARD=on) at http://localhost:8000
SPOTTER_DASHBOARD=off
SPOTTER_DASHBOARD_PORT=8000
SPOTTER_DASHBOARD_HOLD_S=0
SPOTTER_LOT_NAME=My driveway

# Test switches, for rehearsals only; leave both unset for a real run
# SPOTTER_TEST_DROP_READS=start,end[;start,end]  drops every plate read while the rule clock (watched time, in
#   seconds) is inside one of the windows, as if the plate were covered
# SPOTTER_TEST_OUTAGE=start,duration  withholds frames for that window of a live run, in seconds from its start
