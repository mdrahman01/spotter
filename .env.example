# Copy to .env and fill in. .env is gitignored; never commit it.

# Nebius Token Factory key for the Nemotron attendant
NEBIUS_API_KEY=

# Telegram alerts (SPOTTER_ALERTS=telegram): the bot's token; the chat id is found and saved on first use
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The camera (or a video file). The password stays here, off the command line; it is never printed.
SPOTTER_SOURCE=rtsp://user:password@192.168.1.50:554/stream1
# Watch zone x0,y0,x1,y1 as fractions of the frame; python -m spotter.calibrate proposes one
SPOTTER_ZONE=0.35,0.27,0.69,0.69
SPOTTER_PROCESS_FPS=5
SPOTTER_MIN_DET_CONF=0.5
SPOTTER_ARRIVE_READS=5
SPOTTER_ARRIVE_WINDOW_S=3
# Seconds a plate must go unread (watched time) before the car counts as gone: 60 for the live camera
SPOTTER_LEAVE_AFTER_S=60

# Alerts: console (prints) or telegram
SPOTTER_ALERTS=telegram
# The signal light: console (prints) or kasa; the bulb's host from scripts/light_test.py
SPOTTER_LIGHT=kasa
SPOTTER_LIGHT_HOST=
SPOTTER_LIGHT_BRIGHTNESS=100
# Only if the bulb asks for the Kasa account
KASA_USERNAME=
KASA_PASSWORD=

# Money and timers
SPOTTER_MIN_CHARGE_CENTS=100
SPOTTER_ENDING_SOON_S=600
SPOTTER_OVERSTAY_GRACE_S=300
SPOTTER_OVERSTAY_FEE_CENTS=500
